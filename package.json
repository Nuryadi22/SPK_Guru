{
  "name": "spk-guru-sd-wp",
  "version": "1.0.0",
  "description": "Sistem Pendukung Keputusan Pemilihan Guru Berprestasi Sekolah Dasar Menggunakan Metode Weighted Product (WP)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
